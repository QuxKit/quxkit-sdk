{
  "name": "@quxkit/sdk",
  "version": "0.1.0",
  "description": "The composition \u2014 one pool, one transaction discipline, the QuxKit kits wired together and versioned.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 'test/**/*.test.ts'",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm run build && pnpm test"
  },
  "peerDependencies": {
    "pg": ">=8",
    "@quxkit/identity-kit": "*",
    "@quxkit/tenant-kit": "*",
    "@quxkit/billing-kit": "*",
    "@quxkit/mail-kit": "*",
    "@quxkit/comm-kit": "*",
    "@quxkit/integration-kit": "*",
    "@quxkit/content-kit": "*",
    "@quxkit/domain-kit": "*"
  },
  "peerDependenciesMeta": {
    "@quxkit/identity-kit": {
      "optional": true
    },
    "@quxkit/tenant-kit": {
      "optional": true
    },
    "@quxkit/billing-kit": {
      "optional": true
    },
    "@quxkit/mail-kit": {
      "optional": true
    },
    "@quxkit/comm-kit": {
      "optional": true
    },
    "@quxkit/integration-kit": {
      "optional": true
    },
    "@quxkit/content-kit": {
      "optional": true
    },
    "@quxkit/domain-kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.0",
    "pg": "^8.13.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "quxkit",
    "sdk",
    "composition",
    "postgres",
    "multi-tenant"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuxKit/quxkit-sdk.git"
  },
  "homepage": "https://quxkit.ai/solutions/sdk"
}
